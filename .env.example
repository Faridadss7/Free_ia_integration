# ===========================================================================
# Variables d'environnement — MODÈLE (à copier vers .env, jamais committé)
# ===========================================================================
#
# Web3Forms — service qui relaie les soumissions du wizard de paiement vers
# la boîte Gmail de Farid (nom, email, WhatsApp, forfait, ID transaction,
# + capture du SMS en pièce jointe).
#
# Obtenir la clé : https://web3forms.com → saisir son email → recevoir l'access key.
# Copier ce fichier en `.env` et y coller la vraie valeur.
VITE_WEB3FORMS_KEY=votre-access-key-ici

# ===========================================================================
# Cloudinary — hébergement des captures d'écran du SMS de paiement.
# ===========================================================================
#
# Upload NON signé depuis le navigateur : on n'expose JAMAIS l'API secret.
# Créer un upload preset "unsigned" : Cloudinary Console → Settings → Upload →
# Upload presets → Add upload preset → Signing Mode = Unsigned.
#
#   VITE_CLOUDINARY_CLOUD_NAME    — nom du cloud (Console → Dashboard).
#   VITE_CLOUDINARY_UPLOAD_PRESET — nom du preset unsigned créé ci-dessus.
VITE_CLOUDINARY_CLOUD_NAME=votre-cloud-name
VITE_CLOUDINARY_UPLOAD_PRESET=votre-upload-preset

# ---------------------------------------------------------------------------
# Cloudinary — identifiants ADMIN (script local cloudinary-onboarding.js).
# ---------------------------------------------------------------------------
# SANS préfixe VITE_ : ces valeurs ne doivent JAMAIS atteindre le navigateur.
# Utilisées uniquement par le script Node.js de validation de l'intégration.
CLOUDINARY_CLOUD_NAME=votre-cloud-name
CLOUDINARY_API_KEY=votre-api-key
CLOUDINARY_API_SECRET=votre-api-secret
